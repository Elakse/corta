{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"],
      "@content/*": ["../content/*"]
    }
  },
  "include": ["src", "../shared", "../content/**/*.tsx", "vite.config.ts"]
}
