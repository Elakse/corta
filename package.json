{
  "name": "corta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Corta: a personal study platform built from each course's real material.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n app,server -c magenta,cyan \"npm:dev:app\" \"npm:dev:server\"",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "start:server": "tsx server/src/index.ts",
    "typecheck": "tsc -p app && tsc -p server && tsc -p scripts && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ruler": "playwright test tests/ruler.spec.ts",
    "validate": "tsx scripts/validate-content.ts",
    "catalog": "tsx scripts/gen-catalog.ts",
    "coverage": "tsx scripts/check-coverage.ts",
    "new-block": "tsx scripts/new-block.ts",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "check": "npm run typecheck && npm run validate && npm test && npm run test:e2e",
    "extract": "tsx scripts/extract-pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@xyflow/react": "^12.12.0",
    "d3-hierarchy": "^3.1.2",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^183.0.0",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mafs": "^0.21.0",
    "marked": "^18.1.0",
    "mermaid": "^12.1.0",
    "motion": "^14.0.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-router": "^8.4.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "use-resize-observer": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "katex": "$katex",
    "shell-quote": "^1.12.0"
  }
}
