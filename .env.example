# Copy to .env and fill in what you need. Never commit .env.

# --- Server ---
CORTA_PORT=8787
# SQLite file for user state (progress, sessions, settings). Relative to the repo root.
CORTA_DB=server/data/corta.db

# --- LLM side panel (docs/guides/llm-setup.md) ---
CORTA_LLM_PROVIDER=opencode-go
OPENCODE_GO_API_KEY=
CORTA_OPENCODE_GO_MODEL=deepseek-v4.1-flash
CORTA_ANTHROPIC_MODEL=
# OpenCode Go default: deepseek-v4.1-flash. Keep "Use balance" disabled in the Go console.
# Alternative: CORTA_LLM_PROVIDER=anthropic, with ANTHROPIC_API_KEY below.
ANTHROPIC_API_KEY=
# Legacy optional override for the environment's default provider only. Prefer per-provider defaults above.
CORTA_LLM_MODEL=

# --- Google Calendar one-way push (docs/guides/google-calendar-setup.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
